{
  "buildCommand": "bun run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/cron|api/index).*)",
      "destination": "/api/index.js"
    }
  ]
}
